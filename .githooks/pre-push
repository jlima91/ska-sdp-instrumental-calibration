#!/usr/bin/env bash

set -e

# Function to prompt the user with a yes/no question
ask_yes_no() {
    local prompt="$1"
    local response
    while true; do
        read -erp "$prompt [y/n]: " response
        case "$response" in
            [Yy]*) return 0 ;;
            [Nn]*) return 1 ;;
            *) echo "Please answer yes or no." ;;
        esac
    done
}

# Variables
GITLAB_ENDPOINT="https://gitlab.com/api/v4"
PROJECT_ID="62495323" # Replace with your GitLab project ID

# Extract the current branch being pushed
read local_ref ignored_inputs
# Get the name of the branch being pushed
branch=$(git rev-parse --symbolic --abbrev-ref "$local_ref")
branch_encoded=$(jq -rn --arg v "$branch" '$v|@uri')

# Prefer MR pipeline for open MRs on this branch, then fall back to branch pipeline
echo -e "\nPulling pipeline info...\n"
mr_info=$(curl -s "${GITLAB_ENDPOINT}/projects/${PROJECT_ID}/merge_requests?state=opened&source_branch=${branch_encoded}&per_page=1")
mr_iid=$(echo "$mr_info" | jq -r '.[0].iid // empty')

if [[ -n "$mr_iid" ]]; then
    echo "Open MR detected for branch ${branch}: !${mr_iid}"
    mr_pipelines=$(curl -s "${GITLAB_ENDPOINT}/projects/${PROJECT_ID}/merge_requests/${mr_iid}/pipelines?per_page=1")
    pipeline_info=$(echo "$mr_pipelines" | jq -c 'if length > 0 then .[0] else {} end')
    pipeline_context="merge request !${mr_iid}"
else
    pipeline_info=$(curl -s "${GITLAB_ENDPOINT}/projects/${PROJECT_ID}/pipelines/latest?ref=${branch_encoded}")
    pipeline_context="branch ${branch}"
fi

# Extract the pipeline ID and status
pipeline_id=$(echo "$pipeline_info" | jq -r '.id // "null"')
pipeline_status=$(echo "$pipeline_info" | jq -r '.status // "unknown"')
pipeline_url=$(echo "$pipeline_info" | jq -r '.web_url // empty')

PROCEED_TO_PUSH=1
# Check pipeline status
if [[ $pipeline_id != "null" ]]; then
    echo "Pipeline ID: $pipeline_id"
    echo -e "Status: $pipeline_status \n"
    if [[ "$pipeline_status" != "success" ]]; then
        echo "The pipeline status is not 'success'."
        echo -e "Check the latest pipeline here: '${pipeline_url}' \n"
        PROCEED_TO_PUSH=0
    fi
else
    echo -e "No pipeline found for ${pipeline_context}.\n"
    PROCEED_TO_PUSH=0
fi

exec < /dev/tty
[[ $PROCEED_TO_PUSH -eq 0 ]] && ask_yes_no "Do you still want to proceed with the push?" && PROCEED_TO_PUSH=1 && echo ""
exec <&-

if [[ $PROCEED_TO_PUSH -eq 1 ]]; then
    echo "Procedding with the push"
else
    echo "Push aborted"
    exit 1
fi
